---
import { getEntry } from 'astro:content';
import Base from '../layouts/Base.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import BeforeAfter from '../components/BeforeAfter.astro';
import CourseTerms from '../components/CourseTerms.astro';
import { rub, sp } from '../lib/format';
import { courseLd, ogHref } from '../lib/seo';
import meshRaw from '../assets/ai/mesh-raw.jpg';
import meshScene from '../assets/ai/mesh-scene.jpg';

const site = (await getEntry('settings', 'site'))!.data;
const ai = (await getEntry('courses', 'ai'))!.data;
const lab = (await getEntry('courses', 'ai-lab'))!.data;
const months = site.installment.months;
const steps = [
  { t: 'Генерируешь референсы нейросетью', d: 'Собираешь согласованный набор из четырёх видов будущей модели и выбираешь направление до начала моделирования.', result: 'Набор референсов по четырём видам', tools: 'Nano Banana' },
  { t: 'Создаёшь 3D-модель по фото', d: 'Получаешь черновую модель по референсам и переходишь от плоского изображения к объёмной форме.', result: 'Черновая 3D-модель по фото', tools: 'Hunyuan3D, Tripo3D' },
  { t: 'Делаешь ретопологию модели', d: 'После генерации проверяешь плотность и геометрию, очищаешь сетку в Quad Remesher и дорабатываешь её в 3ds Max.', result: 'Чистая сетка для дальнейшей работы', tools: 'Quad Remesher, 3ds Max' },
  { t: 'Генерируешь и доводишь текстуры', d: 'Создаёшь текстуры по описанию и вручную приводишь их к нужному виду.', result: 'Текстуры и материалы модели', tools: 'ИИ-текстурирование' },
  { t: 'Ставишь модель в окружение', d: 'Размещаешь модель в интерьерной сцене или подходящей локации и проверяешь, как она читается в контексте.', result: 'Модель в готовой сцене', tools: 'Nano Banana, Claude' },
  { t: 'Готовишь визуализацию для портфолио', d: 'Собираешь подачу модели в четырёх ракурсах для портфолио и обсуждения с заказчиком.', result: 'Четыре ракурса одной модели', tools: 'Nano Banana' }
];
const faq = [
  ['Я новичок в 3D. Мне подойдёт?', 'Курс рассчитан на тех, у кого есть базовые навыки 3D. Если вы начинаете с нуля, сначала пройдите моделирование в 3ds Max, уровни 1 и 2, а затем переходите к «ИИ в 3D». Так нейросеть будет ускорять работу, а не подменять понимание формы. А в «Базу 3D-визуализатора» этот курс уже входит.'],
  ['ИИ же всё делает сам? Заменит ли он 3D-художника?', 'Нет. Нейросеть выдаёт черновик: рваную сетку, ошибки в форме, сырые текстуры. Дальше решает навык художника: ретопология, доводка текстур и материалов, подача. Этому посвящены шаги 3–6.'],
  ['Я уже умею в 3D. Зачем мне этот курс?', 'Чтобы добавлять нейросети к черновым этапам: подбору референсов, первичной геометрии, текстурам и окружению. Результат всё равно проходит вашу проверку и доработку.'],
  ['Нейросети быстро меняются. Знания не устареют?', 'Мы учим принципу пайплайна, а не кнопкам одного сервиса. Когда выходит новая нейросеть, вы встраиваете её в ту же цепочку: референс, 3D-модель, чистая сетка, текстуры, сцена.'],
  ['Какими нейросетями будем пользоваться?', 'Nano Banana для референсов и окружения, Hunyuan3D и Tripo3D для генерации 3D-модели, Quad Remesher для ретопологии, а также Claude и Генспарк для рабочих задач. Доработку модели делаем в 3ds Max.'],
  ['Нужна ли ретопология модели после нейросети?', 'Да, почти всегда. Нейросеть выдаёт плотную треугольную сетку, которую неудобно текстурировать и править. На шаге 3 делаете автоматическую ретопологию в Quad Remesher и дорабатываете модель в 3ds Max до чистых квадов.'],
  ['Чем «Лаборатория» отличается от «Самостоятельно»?', '«Самостоятельно»: все уроки в записи без проверки и поддержки. «Лаборатория»: обучение в группе с датой старта и живым стримом с разбором полного цикла.'],
];
const crumbs = [{ name: 'Главная', href: '/' }, { name: 'Курсы', href: '/courses' }, { name: 'ИИ в 3D' }];
const ld = [
  courseLd({ name: 'ИИ в 3D', description: 'Нейросети для создания 3D-моделей: референсы, 3D-модель по фото, ретопология, текстуры и визуализация.', path: '/ai', prices: [ai.price, lab.price], image: ogHref('ai') }),
  { '@context': 'https://schema.org', '@type': 'FAQPage', mainEntity: faq.map(([q, a]) => ({ '@type': 'Question', name: q, acceptedAnswer: { '@type': 'Answer', text: a } })) },
];
---
<Base
  title="Нейросети для 3D-моделей: курс «ИИ в 3D», 3D-модель по фото | GRIPINSKY"
  description={`Онлайн-курс «ИИ в 3D»: референсы в нейросетях, 3D-модель по фото в Hunyuan3D и Tripo3D, ретопология, текстуры и визуализация. От ${sp(ai.price)} ₽.`}
  breadcrumbs={crumbs}
  jsonLd={ld}
  ogImage={ogHref('ai')}
  consultContext="Курс ИИ в 3D"
>
  <section class="wrap pt-5 md:pt-7" aria-labelledby="ai-title">
    <Breadcrumbs items={crumbs} class="mb-6" />
    <div class="grid items-center gap-8 md:grid-cols-2 md:gap-12">
      <div class="flex flex-col gap-5">
        <span class="t-overline t-signal">Онлайн-курс</span>
        <h1 id="ai-title" class="t-display">ИИ в 3D: <span class="t-accent">нейросети для <span class="whitespace-nowrap">3D-моделей</span></span></h1>
        <p class="t-quote m-0">ИИ не заменит 3D-художника. Его заменит художник с ИИ</p>
        <p class="t-lead">Весь пайплайн: от референса и 3D-модели по фото до рендера в интерьере. Нейросети помогают с черновыми этапами, а вы проверяете геометрию и доводите результат в 3ds Max.</p>
        <CourseTerms course={ai} />
        <div class="flex flex-col gap-3 sm:flex-row">
          <a href="#tariffs" class="btn btn-primary btn-lg">Выбрать тариф, от {rub(ai.price)}</a>
          <a href="#program" class="btn btn-secondary btn-lg">Программа</a>
        </div>
        <p class="t-small m-0 text-ink-2">Курс входит в «Базу 3D-визуализатора». <a href="/courses-page/visualization#base" class="link">Подробнее о базе</a></p>
      </div>
      <BeforeAfter after={meshScene} before={meshRaw} altAfter="Модель с чистой сеткой в интерьере" altBefore="Модель с кривой сеткой после генерации" caption="Потяните ползунок: модель после нейросети и она же после доработки в интерьере" />
    </div>
  </section>

  <section class="wrap section" aria-labelledby="lose-title">
    <div class="head"><span class="t-overline">Рабочий процесс</span><h2 id="lose-title" class="t-h2">Какие этапы можно <span class="t-accent">ускорить с ИИ</span></h2></div>
    <ul class="m-0 grid list-none gap-4 p-0 md:grid-cols-3">
      {[['Меньше повторяющейся рутины', 'Подготовка референсов, черновой геометрии, текстур и окружения может занимать меньше времени. Финальный результат всё равно проверяет художник.'], ['Быстрее проверять идеи', 'Сравните несколько вариантов референса до того, как начнёте собирать финальную сцену.'], ['Больше вариантов для обсуждения', 'На этапе референсов покажите заказчику несколько направлений и выберите подходящее до моделирования.']].map(([t, d]) => (
        <li class="ai-benefit"><h3 class="t-title">{t}</h3><p class="t-small m-0 text-ink-2">{d}</p></li>
      ))}
    </ul>
  </section>

  <section id="program" class="wrap section" aria-labelledby="program-title">
    <div class="head"><span class="t-overline">Программа: шесть этапов</span><h2 id="program-title" class="t-h2" tabindex="-1">От референса <span class="t-accent">до подачи в портфолио</span></h2><p class="t-lead">Каждый шаг добавляет навык и приводит к следующей части пайплайна.</p></div>
    <ol class="ai-roadmap">
      {steps.map((s, i) => {
        const progress = Math.round(((i + 1) / steps.length) * 100);
        return (
          <li class="ai-roadmap__step">
            <div class="ai-roadmap__progress">
              <span class="ai-roadmap__number" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
              <span class="t-overline">{progress}%</span>
              <div class="ai-roadmap__track" role="progressbar" aria-label={`Пайплайн после этапа ${i + 1}`} aria-valuenow={progress} aria-valuemin="0" aria-valuemax="100"><span style={`width:${progress}%`}></span></div>
            </div>
            <div class="ai-roadmap__copy"><span class="t-overline">Этап {String(i + 1).padStart(2, '0')}</span><h3>{s.t}</h3><p>{s.d}</p></div>
            <div class="ai-roadmap__result"><span class="t-overline">Результат этапа</span><p>{s.result}</p><span class="ai-roadmap__tools">{s.tools}</span></div>
          </li>
        );
      })}
    </ol>
    <p class="ai-tools"><b>Инструменты пайплайна</b><span>Nano Banana, Hunyuan3D, Tripo3D, Quad Remesher, Claude, Генспарк и 3ds Max</span></p>
  </section>

  <section class="wrap section ai-outcomes" aria-labelledby="outcomes-title">
    <div class="ai-outcomes__head">
      <span class="t-overline">Результаты обучения</span>
      <h2 id="outcomes-title" class="t-h2">Что можно <span class="t-accent">добавить в портфолио</span></h2>
      <p class="t-lead">Финальный проект объединяет этапы курса: от исходной модели до готовой подачи.</p>
    </div>
    <ol class="ai-outcomes__list">
      <li><span class="ai-outcomes__n">01</span><div><h3>Модель с чистой сеткой</h3><p>Геометрия, которую можно проверять и дорабатывать в 3ds Max.</p></div></li>
      <li><span class="ai-outcomes__n">02</span><div><h3>Материалы и текстуры</h3><p>Текстуры после генерации и ручной доводки под выбранную модель.</p></div></li>
      <li><span class="ai-outcomes__n">03</span><div><h3>Сцена и четыре ракурса</h3><p>Модель в окружении и серия изображений для портфолио или обсуждения с заказчиком.</p></div></li>
    </ol>
  </section>

  <section class="wrap section" aria-labelledby="who-title">
    <h2 id="who-title" class="t-h2 mb-8">Кому <span class="t-accent">подходит</span></h2>
    <ul class="m-0 grid list-none gap-4 p-0 md:grid-cols-3">
      <li class="card flex flex-col gap-2 p-6"><h3 class="t-title">Практикующим 3D-художникам</h3><p class="t-small m-0 text-ink-2">Подключите нейросети к привычному пайплайну и сохраните ручной контроль над геометрией и подачей.</p></li>
      <li class="card flex flex-col gap-2 p-6"><h3 class="t-title">Новичкам без моделирования</h3><p class="t-small m-0 text-ink-2">Понятная точка входа, но для сильного результата нужна база. <a href="/modeling1" class="link">Начать с 3ds Max</a>.</p></li>
      <li class="card flex flex-col gap-2 p-6"><h3 class="t-title">Выпускникам академии</h3><p class="t-small m-0 text-ink-2">Добавьте новые инструменты к навыкам моделирования и визуализации, которые уже используете.</p></li>
    </ul>
  </section>

  <section id="tariffs" class="wrap section" aria-labelledby="tariffs-title">
    <h2 id="tariffs-title" class="t-h2 mb-8" tabindex="-1">Стоимость <span class="t-accent">курса</span></h2>
    <div class="grid gap-5 md:grid-cols-2">
      <article class="card flex flex-col gap-4 p-6 md:p-8">
        <h3 class="t-h3">Самостоятельно</h3>
        <span><b class="t-num">{rub(ai.price)}</b> <span class="text-muted">разовый платёж</span></span>
        <ul class="m-0 flex list-none flex-col gap-2 p-0 text-ink-2">
          <li>Все 6 шагов пайплайна в записи</li><li>Демо-модель для практики</li><li class="text-muted">Без проверки и поддержки</li>
        </ul>
        <CourseTerms course={ai} compact support="none" />
        <button type="button" class="btn btn-secondary btn-lg mt-auto" data-cart-add="ai" disabled><span data-cart-label>В корзину</span></button>
      </article>
      <article class="flex flex-col gap-4 rounded-card bg-surface-2 p-6 md:p-8">
        <span class="chip self-start !bg-bg !text-muted">Популярный</span>
        <h3 class="t-h3">Лаборатория</h3>
        <span><b class="t-num">{rub(lab.price)}</b> <span class="text-muted">или {sp(Math.ceil(lab.price / months))}&nbsp;₽/мес</span></span>
        <ul class="m-0 flex list-none flex-col gap-2 p-0 text-ink-2">
          <li>Всё из тарифа «Самостоятельно»</li><li>Обучение в группе</li><li>Живой стрим с разбором полного цикла</li><li class="text-muted">Уточните дату ближайшего потока</li>
        </ul>
        <CourseTerms course={lab} compact />
        <button type="button" class="btn btn-primary btn-lg mt-auto" data-cart-add="ai-lab" disabled><span data-cart-label>В корзину</span></button>
      </article>
    </div>
    <p class="t-small mt-4 text-muted">Оплата картой, через СБП, в рассрочку и частями, счёт для юрлиц и ИП.</p>
  </section>

  <section class="wrap section" aria-labelledby="aifaq-title">
    <div class="grid gap-10 md:grid-cols-[4fr_8fr]">
      <h2 id="aifaq-title" class="t-h2">Вопросы <span class="t-accent">о курсе</span></h2>
      <div class="flex max-w-[820px] flex-col">
        {faq.map(([q, a]) => (
          <details class="faq group border-b border-line py-1">
            <summary class="t-title flex min-h-16 items-center justify-between gap-6 py-3">{q}<span aria-hidden="true" class="shrink-0 text-[length:var(--type-icon-lg)] font-medium text-muted transition-transform group-open:rotate-45">+</span></summary>
            <p class="mb-5 mt-0 text-ink-2">{a}</p>
          </details>
        ))}
      </div>
    </div>
  </section>

</Base>

<style>
  .ai-benefit { padding: 20px 0 0; border-top: 1px solid var(--color-line); }
  .ai-benefit h3 { margin: 0 0 8px; }
  .ai-roadmap { margin: 0; padding: 0; list-style: none; border-top: 1px solid var(--color-line); }
  .ai-roadmap__step {
    display: grid;
    grid-template-columns: 56px minmax(0, 1fr);
    gap: 12px 18px;
    padding: 22px 0 24px;
    border-bottom: 1px solid var(--color-line);
  }
  .ai-roadmap__progress { display: flex; flex-direction: column; align-items: flex-start; gap: 8px; }
  .ai-roadmap__number { color: var(--color-ink); font-size: var(--type-number); font-weight: 700; line-height: 1; letter-spacing: -0.04em; }
  .ai-roadmap__track { width: 100%; height: 2px; margin-top: 2px; background: rgb(236 236 230 / .14); }
  .ai-roadmap__track span { display: block; height: 100%; background: var(--color-lime); }
  .ai-roadmap__copy, .ai-roadmap__result { min-width: 0; }
  .ai-roadmap__copy { display: flex; flex-direction: column; gap: 8px; }
  .ai-roadmap__copy h3 { margin: 0; font-size: var(--type-card-title); font-weight: 700; line-height: 1.2; letter-spacing: -.01em; }
  .ai-roadmap__copy p { max-width: 660px; margin: 0; color: var(--color-ink-2); line-height: 1.5; }
  .ai-roadmap__result { grid-column: 2; display: flex; flex-direction: column; align-items: flex-start; gap: 8px; }
  .ai-roadmap__result p { margin: 0; color: var(--color-ink); font-weight: 650; line-height: 1.4; }
  .ai-roadmap__tools { color: var(--color-muted); font-family: var(--font-mono); font-size: var(--type-meta); line-height: 1.4; }
  .ai-tools { display: flex; flex-direction: column; gap: 6px; margin: 20px 0 0; color: var(--color-muted); font-size: var(--type-small); }
  .ai-tools b { color: var(--color-ink-2); font-weight: 600; }
  .ai-outcomes__head { display: flex; max-width: 760px; flex-direction: column; gap: 12px; }
  .ai-outcomes__list { display: grid; grid-template-columns: minmax(0, 1fr); gap: 0; margin: var(--space-head) 0 0; padding: 0; list-style: none; border-top: 1px solid var(--color-line); }
  .ai-outcomes__list li { display: grid; grid-template-columns: 52px minmax(0, 1fr); gap: 16px; padding: 20px 0; border-bottom: 1px solid var(--color-line); }
  .ai-outcomes__n { color: var(--color-muted); font-family: var(--font-mono); font-size: var(--type-meta); }
  .ai-outcomes__list h3 { margin: 0 0 5px; font-size: var(--type-title); font-weight: 700; }
  .ai-outcomes__list p { margin: 0; color: var(--color-ink-2); font-size: var(--type-small); line-height: 1.45; }
  @media (min-width: 768px) {
    .ai-roadmap__step { grid-template-columns: 112px minmax(0, 1.5fr) minmax(190px, .7fr); gap: 32px; padding: 28px 0; }
    .ai-roadmap__progress { gap: 9px; }
    .ai-roadmap__result { grid-column: auto; align-self: center; padding-left: 24px; border-left: 1px solid var(--color-line); }
    .ai-tools { flex-direction: row; flex-wrap: wrap; gap: 6px 24px; }
    .ai-outcomes__list { grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 24px; }
    .ai-outcomes__list li { grid-template-columns: 36px minmax(0, 1fr); align-content: start; gap: 14px; padding: 22px 18px 20px 0; border-bottom: 0; }
    .ai-outcomes__list li + li { border-left: 1px solid var(--color-line); padding-left: 20px; }
  }
</style>

<script>
  import { openCheckout } from '../stores/package';
  document.querySelectorAll<HTMLElement>('[data-buy]').forEach((b) => b.addEventListener('click', () => openCheckout(JSON.parse(b.dataset.buy!))));
</script>
