---
import { Image } from 'astro:assets';
import { getCollection, getEntry } from 'astro:content';
import Base from '../layouts/Base.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import CourseCard from '../components/CourseCard.astro';
import CourseContent from '../components/CourseContent.astro';
import CourseVisualContent from '../components/CourseVisualContent.astro';
import PromoBanner from '../components/PromoBanner.astro';
import CourseHero from '../components/CourseHero.astro';
import CourseTerms from '../components/CourseTerms.astro';
import { TYPE_LABEL, isListed } from '../lib/categories';
import { personMap } from '../lib/people';
import { rub, sp } from '../lib/format';
import { courseLd, ogHref, clipText } from '../lib/seo';

// Страницы курсов по старым адресам Tilda (/interiorpro, /1-2-3lvl …).
// Курсы, которые продаются на другой странице (база), и /ai (своя страница) здесь не создаются.
export async function getStaticPaths() {
  const courses = await getCollection('courses');
  return courses
    .filter((c) => !c.data.landing && c.id !== 'ai' && c.data.legacyPath.split('/').length === 2)
    .map((c) => ({ params: { course: c.data.legacyPath.slice(1) }, props: { id: c.id } }));
}

const { id } = Astro.props;
const entry = (await getEntry('courses', id))!;
const c = entry.data;
const site = (await getEntry('settings', 'site'))!.data;
const people = await personMap();
const months = site.installment.months;
const includes = (await Promise.all(c.includes.map((r) => getEntry('courses', r.id)))).filter(Boolean);
// Педагоги курса публичны (как на странице «Педагоги»): все, кроме явного отказа
const allPeople = await getCollection('people');
const teachers = c.teachers.map((t) => allPeople.find((p) => p.id === t.id)).filter((p) => p && p.data.consent !== 'no' && p.data.teacherPage.show)
  .map((p) => ({ id: p!.id, name: p!.data.name, photo: p!.data.photo, consent: p!.data.consent }));
const vizRelated = c.professions.some((p) => ['Визуализация', 'Интерьер', 'Экстерьер', 'ЖК', 'Стоки', 'Коммерческая визуализация'].includes(p));
const allCourses = await getCollection('courses', (x) => isListed(x.data) && x.id !== id);
const related = (c.related.length
  ? allCourses.filter((x) => c.related.some((r) => r.id === x.id))
  : allCourses.filter((x) => x.data.type !== 'service' && x.data.professions.some((p) => c.professions.includes(p)))
).slice(0, 3);
const isSessionPackage = id === 'paket_ind5' || id === 'paket_ind10';
const isFree = !c.pricePending && (c.type === 'free' || c.price === 0);
const retiredPackage = c.type === 'package';
const visualCourse = c.type === 'course' && !c.pricePending && c.status === 'active' && !['ai','ai-lab'].includes(id);
const Content = visualCourse ? CourseVisualContent : CourseContent;
const hidden = c.status !== 'active';

// SEO-поля выводятся в том виде, в котором сохранены в записи.
// В seo.description можно писать {price}: подставится актуальная цена курса.
const title = c.seo.title || `${c.title}: ${isFree ? 'бесплатный мини-курс' : 'онлайн-курс'} | GRIPINSKY`;
const lead = (c.description || c.short || '').replace(/\s+/g, ' ').trim().replace(/([^.!?])$/, '$1.');
const description = c.seo.description
  ? c.seo.description.replace(/\{price\}/g, sp(c.price))
  : clipText(`${c.title}. ${lead === '.' ? '' : lead} Онлайн-обучение в Академии 3D GRIPINSKY${c.pricePending ? ', стоимость уточняется' : isFree ? ', бесплатно' : `, ${sp(c.price)} ₽, рассрочка`}.`, 200);
const og = c.cover ? ogHref(`course-${id}`) : undefined;
const crumbs = [{ name: 'Главная', href: '/' }, { name: 'Курсы', href: '/courses' }, ...(vizRelated ? [{ name: '3D-визуализация', href: '/courses-page/visualization' }] : []), { name: c.title }];
const ld = courseLd({ name: c.title, description: c.description || c.short || c.title, path: c.legacyPath, prices: retiredPackage || c.pricePending ? [] : [c.price], image: og });
const meta = [c.meta, c.lessons && !c.meta ? `${c.lessons} видеоуроков` : null, c.level].filter(Boolean) as string[];
---
<Base title={title} description={description} ogImage={og} breadcrumbs={crumbs} jsonLd={retiredPackage ? [] : [ld]} noindex={hidden} consultContext={`Курс: ${c.title}`}>
  {visualCourse ? <><div class="wrap pt-5 md:pt-7"><Breadcrumbs items={crumbs} /></div><CourseHero course={c} id={id} /></> : <section class="wrap pt-5 md:pt-7" aria-labelledby="course-title">
    <Breadcrumbs items={crumbs} class="mb-6" />
    <div class:list={["grid items-center gap-8 md:gap-12", c.cover && "md:grid-cols-2"]}>
      <div class="flex min-w-0 flex-col gap-5">
        <span class="t-overline">{TYPE_LABEL[c.type]}</span>
        <h1 id="course-title" class="t-display normal-case">{c.title}</h1>
        {(c.short || c.description) && <p class="t-lead">{c.short && c.short.toLowerCase() !== c.title.toLowerCase() ? c.short : c.description || c.short}</p>}
        {meta.length > 0 && <p class="t-small m-0 text-ink-2">{meta.join(', ')}</p>}
        {c.software.length > 0 && <p class="t-small m-0 text-muted">{c.software.join(', ')}</p>}
        <CourseTerms course={c} />
        <div class="flex flex-wrap gap-3">
          <a href={c.pricePending ? "#consult" : "#course-price"} class="btn btn-primary">{c.pricePending ? 'Уточнить стоимость' : retiredPackage ? 'Выбрать курсы' : isFree ? 'Получить доступ' : c.type === 'course' ? `Выбрать курс, ${rub(c.price)}` : `Стоимость, ${rub(c.price)}`}</a>
          {(c.modules.length > 0 || c.blocks.length > 0) && <a href="#course-program" class="btn btn-secondary">Программа</a>}
        </div>
        {c.trial && <a href={c.trial} class="link t-small self-start">Попробовать бесплатные уроки</a>}
      </div>
      {c.cover && <div class="media-frame media-frame--card bg-surface-2">
        <Image src={c.cover} alt={`Обложка курса «${c.title}»`} widths={[480, 800, 1200]} sizes="(min-width: 768px) 45vw, 90vw" loading="eager" class="h-full w-full object-cover" />
      </div>}
    </div>
  </section>}

  <div class="wrap"><PromoBanner placement="course-aside" class="mt-8" /></div>
  <Content course={c} teachers={teachers}>
    <section slot="price" id="course-price" class:list={["wrap section", visualCourse && "course-visual-price"]} aria-labelledby="course-price-title">
      <div class="grid gap-8 md:grid-cols-[4fr_8fr] md:gap-12">
        <div><span class="t-overline">{retiredPackage ? 'Выбор курсов' : 'Обучение'}</span><h2 id="course-price-title" class="t-h2 mt-3">{retiredPackage ? 'Соберите свою подборку' : isFree ? 'Доступ к курсу' : 'Стоимость обучения'}</h2>{visualCourse && <><p class="t-lead text-ink-2 mt-6">{c.title}</p><ul class="t-body text-ink-2 list-disc pl-5 space-y-3 mt-6">{c.included.map(text => <li>{text}</li>)}</ul></>}</div>
      <div class="card flex flex-col gap-4 p-6 md:p-8">
        {retiredPackage ? (
          <><span class="t-h3">Соберите свой пакет</span><p class="text-ink-2">Этот готовый пакет больше не продаётся. Выберите нужные курсы отдельно, скидка рассчитается в корзине.</p><a href="/courses" class="btn btn-primary">Выбрать курсы</a><a href="/courses-page/visualization#base" class="link">База 3D-визуализатора остаётся доступна целиком</a></>
        ) : c.pricePending ? (
          <>
            <span class="t-title">Стоимость уточняется</span>
            <p class="t-body text-ink-2">Уточните стоимость курса и полного набора на консультации.</p>
            <CourseTerms course={c} compact />
            <a href="#consult" class="btn btn-primary btn-block">Уточнить стоимость</a>
          </>
        ) : isFree ? (
          <>
            <span class="t-num text-ink">Бесплатно</span>
            <span class="text-ink-2">Бесплатный мини-курс: оцените формат и педагога до покупки.</span>
            <a href={site.telegramBot} class="btn btn-primary btn-lg btn-block">Получить доступ</a>
          </>
        ) : (
          <>
            <span class="flex items-baseline gap-3">
              <span class="t-num">{rub(c.price)}</span>
              {c.oldPrice && c.oldPrice > c.price && c.type !== 'package' && !isSessionPackage && <s class="text-muted">{rub(c.oldPrice)}</s>}
            </span>
            {c.oldPrice && c.oldPrice > c.price && (c.type === 'package' || isSessionPackage) && <span class="t-small text-ink-2">{isSessionPackage ? 'Занятия' : 'Курсы пакета'} по отдельности стоят {rub(c.oldPrice)}, выгода {rub(c.oldPrice - c.price)}</span>}
            <span class="t-small text-muted">или {sp(Math.ceil(c.price / months))}&nbsp;₽/мес в рассрочку на {months} мес.</span>
            <CourseTerms course={c} compact />
            {c.type === 'course' ? <button type="button" class="btn btn-primary btn-lg btn-block" data-cart-add={id} disabled><span data-cart-label>В корзину</span></button> : <button type="button" class="btn btn-primary btn-lg btn-block" data-buy={JSON.stringify({ kind: 'course', id, name: c.title, price: c.price })}>Выбрать услугу</button>}
            <a href={`${site.telegramBot}?start=installment`} class="btn btn-secondary btn-block">Оформить рассрочку</a>
          </>
        )}
        {c.trial && <a href={c.trial} class="link t-small text-center">Сначала бесплатные уроки →</a>}
        {vizRelated && !isFree && !retiredPackage && <a href="/courses-page/visualization#profession" class="link-muted t-small text-center">Выбрать дополнительные курсы</a>}
        <a href="#consult" class="link t-small text-center">Бесплатная консультация</a>
      </div>
      </div>
    </section>
  </Content>

  {includes.length > 0 && (
    <section class="wrap section" aria-labelledby="includes-title">
      <h2 id="includes-title" class="t-h2 mb-6">Состав <span class="t-accent">пакета</span></h2>
      <div class="grid gap-5 sm:grid-cols-2 md:grid-cols-3">{includes.map((x) => <CourseCard course={x!} />)}</div>
    </section>
  )}

  {related.length > 0 && (
    <section class="wrap section" aria-labelledby="related-title">
      <div class="mb-6 flex flex-wrap items-end justify-between gap-4">
        <h2 id="related-title" class="t-h2">Похожие <span class="t-accent">курсы</span></h2>
        <a href="/courses" class="link">Все курсы →</a>
      </div>
      <div class="grid gap-5 sm:grid-cols-2 md:grid-cols-3">{related.map((x) => <CourseCard course={x} />)}</div>
    </section>
  )}

</Base>

<script>
  import { openCheckout } from '../stores/package';
  document.querySelectorAll<HTMLElement>('[data-buy]').forEach((b) => b.addEventListener('click', () => openCheckout(JSON.parse(b.dataset.buy!))));
</script>

<style>
 .course-visual-price :global(.card){border-radius:2px;border-top:1px solid var(--color-line-strong);background:var(--color-surface)}
 :global(body:has([data-course-program])){--course-anchor-offset:calc(var(--header-h) + 70px)}
 :global(body:has([data-course-program]) [id^="course-"]){scroll-margin-top:var(--course-anchor-offset)}
</style>
