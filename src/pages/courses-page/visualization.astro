---
import { getCollection, getEntry } from 'astro:content';
import Base from '../../layouts/Base.astro';
import HeroWork from '../../components/HeroWork.astro';
import { heroSlides } from '../../lib/hero';
import HeroActions from '../../components/HeroActions.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import CourseCard from '../../components/CourseCard.astro';
import ProfessionOffers from '../../components/viz/ProfessionOffers.astro';
import { quoteSet } from '../../lib/pricing';
import VizProof from '../../components/viz/VizProof.astro';
import VizReviews from '../../components/viz/VizReviews.astro';
import { courseHref } from '../../lib/categories';
import { rub } from '../../lib/format';
import PrototypeCartHint from '../../islands/PrototypeCartHint';
import { getCatalog } from '../../lib/catalog';
import { faqLd } from '../../lib/views';

const cat = await getCatalog();
const faqSchema = await faqLd('viz');
const crumbs = [{ name: 'Главная', href: '/' }, { name: 'Курсы', href: '/courses' }, { name: '3D-визуализация' }];
const professions = (await getCollection('professions')).sort((a,b) => a.data.order - b.data.order);
const panels = await Promise.all(professions.map(async p => ({ ...p,
  addons: await Promise.all(p.data.addons.filter(a => a.course.id !== 'ai').map(async a => ({ text: a.text, course: (await getEntry('courses', a.course.id))! }))),
  fullPack: await Promise.all(p.data.fullPack.map(c => getEntry('courses', c.id))),
  courses: await Promise.all(['modeling1','modeling2','vizualization3','ai',...p.data.courses.map(c=>c.course.id)].map(id=>getEntry('courses',id))),
})));
const base = (await getEntry('courses','baza'))!;
const baseParts = await Promise.all(base.data.includes.map(c => getEntry('courses', c.id)));
const baseOffer = {
  title: base.data.title,
  items: baseParts.filter(c => !!c).map(c => ({ title: c.data.title, href: courseHref(c.id, c.data) })),
  gifts: base.data.gifts.map(g => g.name),
  price: quoteSet(cat, { ids: [base.id], support: 'chat' }).total,
};
const fullOffer = (p: typeof panels[number]) => {
  const ids = p.data.fullPack.map(c => c.id);
  const gift = cat.professions[p.id as keyof typeof cat.professions].gift;
  const available = ids.length > 0 && ids.every(id => id === base.id || Object.hasOwn(cat.courses, id));
  return {
    title: `${p.data.title} с нуля`,
    items: p.fullPack.flatMap(c => c && c.id !== gift.id ? [{ title: c.data.title, href: c.id === base.id ? `#base-offer-title-${p.id}` : courseHref(c.id, c.data) }] : []),
    gifts: [...baseOffer.gifts, gift.name],
    ids,
    price: available ? quoteSet(cat, { ids, support: 'chat' }).total : null,
  };
};
const freeCourses = await Promise.all(['vizualization3_mini', 'interiorpro_mini'].map(id => getEntry('courses', id)));
// Слайды первого экрана редактируются в админке: «Слайды первого экрана»
const slides = await heroSlides('viz');
---
<Base title="Курсы 3D-визуализации: профессии и обучение | GRIPINSKY" description="Выберите профессию 3D-визуализатора: интерьеры, экстерьеры или модели для стоков. Основные и дополнительные курсы, работы учеников и бесплатные уроки." breadcrumbs={crumbs} jsonLd={[faqSchema]} consultContext="Направление 3D-визуализация">
  {slides[0] && <HeroWork work={slides[0]} slides={slides} kicker="Направление" id="prototype-title" class="hero--cinema">
    <Breadcrumbs slot="top" items={crumbs} />
    <h1 slot="title" id="prototype-title" class="t-hero t-hero--long">3D-визуализация <span class="t-accent block">от первых моделей<br />к вашим проектам</span></h1>
    <p slot="lead" class="t-lead">Научитесь создавать интерьеры, экстерьеры и модели для стоков. Начните с основ или выберите курсы под свой опыт. Моделирование, свет, материалы и нейросети складываются в маршрут к выбранной профессии.</p>
    <HeroActions slot="cta" primaryHref="#profession" primaryLabel="Выбрать курсы" secondaryHref="/vizualization3_mini" secondaryLabel="Попробовать бесплатно" secondaryGoal="trial_click" />
  </HeroWork>}
  <section id="profession" class="wrap section prototype-professions" aria-labelledby="profession-title">
    <div class="prototype-start" aria-labelledby="route-title">
      <h3 id="route-title" class="t-title">С чего начать</h3>
      <div class="prototype-route-grid">
        <article><p class="t-overline">Первый опыт в 3D</p><h4 class="t-small">Начните с основных курсов</h4><p class="t-small text-ink-2">Освойте моделирование, рендер и ИИ. Затем переходите к выбранной профессии.</p><a href="#profession" class="link t-small" data-route-start="base">Начать с основ →</a></article>
        <article><p class="t-overline">Уже работаете в 3ds Max и Corona</p><h4 class="t-small">Выберите специализацию</h4><p class="t-small text-ink-2">Выберите интерьеры, экстерьеры или модели для стоков. Добавьте инструменты под свои задачи.</p><a href="#profession" class="link t-small" data-route-start="specialization">Перейти к специализации →</a></article>
      </div>
    </div>
    <div class="prototype-heading">
      <div><p class="t-overline">Профессии / 3D-визуализация</p><h2 id="profession-title" class="t-h2">Выберите <span class="t-accent">профессию</span></h2></div>
      <p class="t-lead">Основные курсы задают маршрут. Дополнительные помогают освоить нужные инструменты, их можно добавить по желанию. Если уже знаете основы, переходите к следующему курсу.</p>
    </div>
    <div class="prototype-tabs" role="tablist" aria-label="Профессия визуализатора">{panels.map((p,i)=><button type="button" role="tab" id={`viz-tab-${p.id}`} aria-controls={`viz-panel-${p.id}`} aria-selected={i===0?'true':'false'} tabindex={i===0?0:-1} data-viz-profession={p.id} class="btn btn-secondary"><span class="profession-label-full">{p.data.title}</span><span class="profession-label-short">{p.id === 'int' ? 'Интерьеры' : p.id === 'ext' ? 'Экстерьеры' : 'Стоки'}</span></button>)}</div>
    {panels.map((p,i)=><div class="prototype-panel" id={`viz-panel-${p.id}`} role="tabpanel" aria-labelledby={`viz-tab-${p.id}`} hidden={i!==0}>
      <div class="prototype-description"><div><h3 class="t-h3">{p.data.short}</h3><p class="t-body text-ink-2">{p.data.lead}</p></div><aside class="prototype-result"><p class="t-overline text-muted">В вашем портфолио</p><p class="t-title">{p.data.portfolio}</p><a href="#works" class="link t-small">Работы учеников →</a></aside></div>
      <h3 class="t-title prototype-section-title">Проходите по порядку, выбирайте отдельные курсы или <a href={`#profession-offers-title-${p.id}`} class="link prototype-packages-link">сразу пакет</a></h3>
      <div class="prototype-course-grid">{p.courses.map((c,index)=>c&&<div data-course-stage={p.data.courses.some(pc=>pc.course.id===c.id)?"specialization":"base"}><p class="t-num t-mono"><span class="sr-only">Шаг </span>{String(index+1).padStart(2,'0')}</p><CourseCard course={c} framed selectable /></div>)}</div>
      <h3 id={i === 0 ? "additional" : undefined} class="t-title prototype-section-title">Дополнительные курсы</h3>
      <p class="t-small text-ink-2">Усильте навыки под свои задачи. Выберите нужные инструменты, остальные можно добавить позже.</p>
      <div class="prototype-addon-grid">{p.addons.map(a => <article>
        {a.course.data.badges.length > 0 && <div class="addon-badges">{a.course.data.badges.map(b => <span class:list={['addon-badge', `addon-badge--${b.tone}`]}>{b.text}</span>)}</div>}
        <p class="t-overline">По желанию</p><h4 class="t-title"><a href={courseHref(a.course.id,a.course.data)} class="link">{a.course.data.title} ↗</a></h4>
        <p class="t-small text-ink-2">{a.text}</p><a href={courseHref(a.course.id,a.course.data)} class="link t-small">Программа курса →</a>
        <div class:list={["prototype-addon-buy", { "prototype-addon-buy--pending": a.course.data.pricePending }]}>{a.course.data.pricePending ? <><span class="t-small text-muted">Стоимость уточняется</span><a href={`${courseHref(a.course.id,a.course.data)}#consult`} class="link t-small">Уточнить стоимость →</a></> : <><b class="t-title">{rub(a.course.data.price)}</b><label class="prototype-course-select t-small"><input type="checkbox" data-cart-select={a.course.id} disabled /><span>Выбрать курс</span></label></>}</div>
      </article>)}</div>
      <div id={i === 0 ? "base" : undefined} class="prototype-offers"><ProfessionOffers professionId={p.id} professionTitle={p.data.title} portfolio={p.data.portfolio} base={baseOffer} full={fullOffer(p)} /></div>
    </div>)}

  </section>
  <div class="prototype-proof"><div id="works"><VizProof variant="gallery" wideId="import-17dcd4db8ee2b5b7" trioIds={["import-9f6284ff86050815", "meshkov-lake-house", "filimonova-spalnya"]} /></div>      <div class="prototype-free wrap">
        <div><p class="t-overline">Начните бесплатно</p><p class="t-small">Попробуйте создать свою первую сцену на бесплатных уроках.</p></div>
        <div class="prototype-free-links">{freeCourses.map(c => c && <a href={c.data.legacyPath} class="btn btn-secondary">{c.data.title} ↗</a>)}</div>
      </div>
<VizReviews /></div>
  <section id="prototype-faq" class="wrap section prototype-faq" aria-labelledby="prototype-faq-title">
    <div class="prototype-faq-layout"><div class="prototype-faq-heading">    <p class="t-overline">Перед стартом</p><h2 id="prototype-faq-title" class="t-h2">Вопросы</h2><p class="t-body text-ink-2">Не нашли ответ? <a href="#consult" class="link">Спросите на консультации</a> или в <a href="https://t.me/Academy3D_bot" class="link">Telegram</a>.</p>
</div><div class="prototype-faq-items">    <details class="faq"><summary class="t-title">Можно начать без опыта?<span aria-hidden="true" class="prototype-faq-plus">+</span></summary><p class="t-body">Да. Начните с бесплатных уроков, затем переходите к первому уровню моделирования. Основные курсы выстраивают базу перед специализацией.</p></details>
    <details class="faq"><summary class="t-title">Какие программы и компьютер нужны?<span aria-hidden="true" class="prototype-faq-plus">+</span></summary><p class="t-body">В основе направления используются 3ds Max и Corona. Дополнительные инструменты зависят от выбранных курсов. Сверьте характеристики компьютера с требованиями используемых версий программ; если сомневаетесь, обсудите свой компьютер на консультации.</p></details>
    <details class="faq"><summary class="t-title">Куда обращаться, если возникнут сложности?<span aria-hidden="true" class="prototype-faq-plus">+</span></summary><p class="t-body">В корзине можно выбрать обучение с чатом поддержки или самостоятельный формат. Для индивидуального разбора можно обсудить работу с наставником. Условия проверки заданий уточняйте для выбранного курса и формата.</p></details>
    <details class="faq"><summary class="t-title">Нужно покупать весь маршрут сразу?<span aria-hidden="true" class="prototype-faq-plus">+</span></summary><p class="t-body">Можно выбрать отдельные курсы под свой опыт и задачи. Скидка за количество рассчитывается в корзине; включённые курсы и подарки учитываются автоматически.</p></details>
</div></div>
  </section>
  <PrototypeCartHint client:load cat={cat} />
</Base>
<script>
  const tabs=[...document.querySelectorAll<HTMLButtonElement>('[data-viz-profession]')];
  const panels=[...document.querySelectorAll<HTMLElement>('.prototype-panel')];
  const activate=(index:number)=>{
    const bar=document.querySelector<HTMLElement>('.prototype-tabs')!;
    const pinned= bar.getBoundingClientRect().top <= parseFloat(getComputedStyle(bar).top)+2;
    document.documentElement.style.setProperty('--prototype-tabs-h', `${bar.offsetHeight}px`);
    tabs.forEach((t,i)=>{t.setAttribute('aria-selected',String(i===index));t.tabIndex=i===index?0:-1;});panels.forEach((p,i)=>p.hidden=i!==index);
    if(pinned)requestAnimationFrame(()=>panels[index].scrollIntoView({block:'start',behavior:'instant'}));
  };
  const linkedProfession = location.hash.match(/^#(?:base-offer-title|profession-offers-title)-(int|ext|stock)$/)?.[1];
  const requested = linkedProfession ?? new URLSearchParams(location.search).get('prof');
  const requestedIndex = tabs.findIndex(tab=>tab.dataset.vizProfession===requested);
  if(requestedIndex>=0) activate(requestedIndex);
  if(linkedProfession) {
    const scrollToOffer = async () => {
      await document.fonts.ready;
      requestAnimationFrame(()=>document.getElementById(location.hash.slice(1))?.scrollIntoView({block:'start',behavior:'instant'}));
    };
    if(document.readyState === 'complete') void scrollToOffer();
    else window.addEventListener('load', scrollToOffer, { once: true });
  }
  if(location.hash==='#base') { activate(0); const base=document.querySelector<HTMLElement>('#base'); if(base)requestAnimationFrame(()=>base.scrollIntoView({block:'start'})); }
  const tabBar=document.querySelector<HTMLElement>('.prototype-tabs')!;
  new ResizeObserver(()=>document.documentElement.style.setProperty('--prototype-tabs-h', `${tabBar.offsetHeight}px`)).observe(tabBar);
  tabs.forEach((tab,i)=>{tab.addEventListener('click',()=>activate(i));tab.addEventListener('keydown',e=>{let n=i;if(e.key==='ArrowRight')n=(i+1)%tabs.length;else if(e.key==='ArrowLeft')n=(i-1+tabs.length)%tabs.length;else if(e.key==='Home')n=0;else if(e.key==='End')n=tabs.length-1;else return;e.preventDefault();activate(n);tabs[n].focus();});});
  document.querySelectorAll<HTMLAnchorElement>('[data-route-start]').forEach(link=>link.addEventListener('click',event=>{
    const panel=panels.find(p=>!p.hidden);
    const target=panel?.querySelector<HTMLElement>(`[data-course-stage="${link.dataset.routeStart}"]`);
    if(target){event.preventDefault();target.scrollIntoView({behavior:window.matchMedia('(prefers-reduced-motion: reduce)').matches?'instant':'smooth',block:'start'});}
  }));
</script>
<style>
  .prototype-start { margin:0 0 var(--space-section); }
  .prototype-route-grid { display:grid; grid-template-columns:repeat(2,minmax(0,1fr)); gap:24px; margin-top:var(--space-head); }
  .prototype-route-grid article { border-radius:var(--radius-card); padding:16px 20px; background:var(--color-surface); border-top:1px solid var(--color-line-strong); }
  .prototype-route-grid .t-overline { color:var(--color-muted); margin:0 0 8px; }
  .prototype-route-grid h4 { margin:0 0 8px; font-weight:650; }
  .prototype-route-grid article > p.t-small { margin:0 0 12px; }
  .prototype-result { padding-left:24px; border-left:1px solid var(--color-line-strong); }
  .prototype-result > .t-overline { margin:0 0 12px; }
  .prototype-result > .t-title { margin:0; max-width:28ch; }
  .prototype-result a { display:inline-block; margin-top:20px; }
  [data-course-stage] { scroll-margin-top:calc(var(--header-h) + var(--prototype-tabs-h, 85px) + 16px); }
  @media(max-width:767px) { [data-course-stage] { scroll-margin-top:calc(var(--header-h) + var(--prototype-tabs-h, 85px) + 16px); } }
  .prototype-faq-layout { display:grid; grid-template-columns:1fr 2fr; gap:var(--space-sub); align-items:start; }
  .prototype-faq-heading { align-self:start; }
  .prototype-faq-heading .t-overline { color:var(--color-muted); margin:0 0 18px; }
  .prototype-faq-heading h2 { margin:0; }
  .prototype-faq-heading > p:last-child { margin:16px 0 0; max-width:36ch; }
  .prototype-faq details { border-bottom:1px solid var(--color-line); }
  .prototype-faq details:first-child { border-top:1px solid var(--color-line); }
  .prototype-faq summary { display:flex; align-items:center; justify-content:space-between; gap:24px; min-height:63px; padding:12px 0; cursor:pointer; font-size:var(--type-body); font-weight:600; list-style:none; }
  .prototype-faq summary::-webkit-details-marker { display:none; }
  .prototype-faq-plus { flex-shrink:0; color:var(--color-muted); font-size:var(--type-title); transition:transform .2s; }
  .prototype-faq details[open] .prototype-faq-plus { transform:rotate(45deg); }
  .prototype-faq details p { max-width:68ch; color:var(--color-ink-2); margin:0; padding-bottom:20px; }
  @media(max-width:767.98px) { .prototype-faq-layout { grid-template-columns:1fr; gap:61px; } .prototype-faq-heading { position:static; } }
  @media(max-width:560px) { .prototype-faq-layout { gap:25px; } .prototype-faq summary { min-height:59px; padding:13px 0; } }
  @media(max-width:767px){.prototype-route-grid{grid-template-columns:1fr;gap:24px;}.prototype-route-grid article{padding:16px;}}

  .prototype-note { padding-top:calc(var(--header-h) + 20px); padding-bottom:20px; display:flex; flex-wrap:wrap; justify-content:space-between; gap:16px; }
  :global(body:has([data-prototype-empty-cart])) { padding-bottom:var(--prototype-hint-h, 120px); }
  .prototype-note + :global(.hero) { padding-top:0; }
  .prototype-professions { padding-bottom:0; }
  .prototype-proof :global(.viz-reviews) { margin-top:var(--space-sub); padding-block:var(--space-sub); }
  .prototype-proof :global(.viz-more) { display:inline-flex; margin-top:28px; min-height:44px; align-items:center; }
  .prototype-heading { display:grid; grid-template-columns:3fr 2fr; gap:var(--space-sub); margin-bottom:0; }
  .prototype-heading .t-overline { margin:0 0 18px; }
  .prototype-heading > p { margin:0; max-width:640px; color:var(--color-ink-2); }
  .prototype-tabs { position:sticky; top:var(--header-h); z-index:30; display:flex; flex-wrap:wrap; gap:12px; margin:var(--space-sub) 0 var(--space-head); padding-block:12px; background:var(--color-bg); border-bottom:1px solid var(--color-line); }
  .prototype-panel { scroll-margin-top:calc(var(--header-h) + var(--prototype-tabs-h, 85px) + 16px); overflow-anchor:none; }
  .profession-label-short { display:none; }
  @media(max-width:767px) {
    .prototype-start { margin-bottom:var(--space-section); }
    .prototype-heading { margin-bottom:0; }
    .prototype-tabs { position:sticky; top:var(--header-h); z-index:30; display:grid; grid-template-columns:repeat(3,minmax(0,1fr)); gap:6px; margin-inline:calc(-1 * var(--site-gutter)); padding:10px var(--site-gutter); background:var(--color-bg); border-bottom:1px solid var(--color-line); }
    .prototype-panel { scroll-margin-top:calc(var(--header-h) + var(--prototype-tabs-h, 85px) + 16px); overflow-anchor:none; }
    .prototype-tabs button { min-width:0; padding-inline:6px; }
    .profession-label-full { display:none; }
    .profession-label-short { display:inline; }
  }
  .prototype-tabs [aria-selected="true"] { border-color:var(--color-lime); color:var(--color-lime); }
  .prototype-panel[hidden] { display:none; }
  .prototype-description { display:grid; grid-template-columns:3fr 2fr; gap:var(--space-sub); align-items:start; margin-bottom:var(--space-sub); }
  .prototype-description > div > p { margin:16px 0 0; max-width:56ch; }
  .prototype-description h3 { max-width:28ch; text-wrap:balance; }
  @media(max-width:767.98px) { .prototype-description { grid-template-columns:1fr; gap:24px; } .prototype-result { padding-left:16px; } }
  .prototype-free { display:flex; align-items:center; justify-content:space-between; flex-wrap:wrap; gap:20px; margin-top:var(--space-head); padding:var(--pad-l); border:1px solid var(--color-line); background:var(--color-surface); }
  .prototype-proof > .prototype-free { margin-top:var(--space-sub); padding-block:var(--space-head) 0; padding-inline:var(--site-gutter); border:0; border-top:1px solid var(--color-line); background:transparent; }
  .prototype-free p { margin:0; }
  .prototype-free .t-overline { color:var(--color-muted); }
  .prototype-free .t-small { margin-top:10px; color:var(--color-ink-2); }
  .prototype-free-links { display:flex; flex-wrap:wrap; gap:12px; }
  .prototype-free-links a { max-width:100%; white-space:normal; }
  .prototype-section-title { margin:var(--space-sub) 0 var(--space-head); padding-block:16px; border-bottom:1px solid var(--color-line); }
  .prototype-packages-link { white-space:nowrap; text-decoration-color:currentColor; }
  .prototype-addon-grid { display:grid; grid-template-columns:repeat(3,minmax(0,1fr)); gap:var(--gap-grid); margin-top:var(--space-head); }
  .prototype-addon-grid article { border-radius:var(--radius-card); display:flex; flex-direction:column; align-items:flex-start; min-width:0; padding:24px; border-top:1px solid var(--color-line-strong); background:var(--color-surface); }
  .prototype-addon-grid article > .t-overline { color:var(--color-muted); margin:0; }
  .prototype-addon-grid h4 { margin:14px 0 12px; }
  .prototype-addon-grid article > p { margin:0 0 16px; }
  .prototype-course-select { display:flex; align-items:center; justify-content:center; width:100%; gap:12px; min-height:52px; padding:0 16px; border:1px solid var(--color-line-strong); border-radius:var(--radius-card); cursor:pointer; font-weight:600; }
  .prototype-course-select input { width:24px; height:24px; flex-shrink:0; accent-color:var(--color-lime); cursor:pointer; }
  .prototype-course-select:has(:checked) { border-color:var(--color-lime); }
  .prototype-addon-buy { display:flex; flex-wrap:wrap; justify-content:space-between; align-items:center; gap:12px; width:100%; padding-top:24px; margin-top:auto; }
  .prototype-addon-buy--pending { margin-top:0; }
  .prototype-section-head { margin:40px 0 24px; border-top:1px solid var(--color-line); padding-top:24px; }
  .prototype-section-head .t-overline { color:var(--color-muted); margin:0 0 12px; }
  .prototype-section-head > p:last-child { margin:16px 0 0; }
