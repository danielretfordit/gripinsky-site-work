---
import type { CollectionEntry } from 'astro:content';

interface Props {
  course: Pick<CollectionEntry<'courses'>['data'], 'studyDuration' | 'accessDuration' | 'supportDuration'>;
  compact?: boolean;
  support?: 'available' | 'none';
}
const { course, compact = false, support = 'available' } = Astro.props;
const hasTerms = course.studyDuration || course.accessDuration || course.supportDuration;
const terms = [
  { label: 'Прохождение', value: course.studyDuration },
  { label: 'Доступ к урокам', value: course.accessDuration },
  { label: support === 'none' ? 'Поддержка' : 'Поддержка с чатом', value: support === 'none' ? 'Не включена' : course.supportDuration },
].filter(term => term.value);
---
{hasTerms && <div class:list={['course-terms', { 'course-terms--compact': compact }]}>
  <dl class="course-terms__list" aria-label="Сроки и условия обучения">
    {terms.map(term => <div class="course-terms__item"><dt>{term.label}</dt><dd>{term.value}</dd></div>)}
  </dl>
  {!compact && <p class="course-terms__note">Темп прохождения индивидуальный.{support === 'available' && course.supportDuration ? ' Поддержка доступна в формате с чатом.' : ''}</p>}
</div>}
<style>
  .course-terms { width: 100%; min-width: 0; container-type: inline-size; }
  .course-terms__list { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: var(--stack-lead); margin: 0; }
  .course-terms__item { display: flex; min-width: 0; flex-direction: column; gap: var(--stack-tight); }
  .course-terms__item dt { color: var(--color-muted); font-size: var(--type-caption); line-height: 1.5; }
  .course-terms__item dd { margin: 0; color: var(--color-ink); font-size: var(--type-title); font-weight: 600; line-height: 1.3; white-space: nowrap; }
  .course-terms__note { margin: var(--stack-lead) 0 0; color: var(--color-muted); font-size: var(--type-caption); line-height: 1.5; }
  .course-terms--compact { margin-block: var(--stack-tight); }
  .course-terms--compact .course-terms__list { grid-template-columns: minmax(0, 1fr); gap: var(--stack-tight); }
  .course-terms--compact .course-terms__item { flex-direction: row; align-items: baseline; justify-content: space-between; }
  .course-terms--compact .course-terms__item dd { font-size: var(--type-small); }
  @container (max-width: 26rem) {
    .course-terms__list { grid-template-columns: minmax(0, 1fr); gap: var(--stack-tight); }
    .course-terms__item { flex-direction: row; align-items: baseline; justify-content: space-between; }
    .course-terms__item dd { font-size: var(--type-small); }
  }
</style>
