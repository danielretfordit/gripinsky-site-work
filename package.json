{
  "name": "gripinsky-site",
  "type": "module",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev",
    "dev:lan": "astro dev --host",
    "build": "astro check && astro build",
    "preview": "astro preview --port 4322",
    "preview:lan": "astro preview --host --port 4322",
    "check": "astro check",
    "test": "node --test tests/*.test.ts && node scripts/check-schema-parity.mjs",
    "lint:copy": "node scripts/lint-copy.mjs",
    "check:urls": "node scripts/check-urls.mjs",
    "check:seo": "node scripts/check-seo.mjs",
    "import:tilda": "node scripts/import-tilda.mjs",
    "e2e": "playwright test",
    "e2e:report": "playwright show-report e2e-report",
    "lint:css": "node scripts/lint-css.mjs",
    "visual": "playwright test -c playwright.visual.config.ts",
    "visual:update": "playwright test -c playwright.visual.config.ts --update-snapshots",
    "visual:audit": "node scripts/visual-audit-summary.mjs",
    "check:schema": "node scripts/check-schema-parity.mjs",
    "check:bundle": "node scripts/check-bundle.mjs"
  },
  "dependencies": {
    "@astrojs/markdoc": "2.1.0",
    "@astrojs/node": "11.1.8",
    "@astrojs/preact": "6.1.0",
    "@astrojs/react": "7.1.0",
    "@astrojs/sitemap": "3.7.4",
    "@keystatic/astro": "6.0.0",
    "@keystatic/core": "0.6.9",
    "@nanostores/preact": "1.1.1",
    "@tailwindcss/vite": "4.3.3",
    "astro": "7.4.0",
    "nanostores": "1.5.5",
    "preact": "10.29.8",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "sharp": "0.35.5",
    "tailwindcss": "4.3.3"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.10",
    "@fontsource-variable/geologica": "^5.3.0",
    "@fontsource-variable/golos-text": "^5.3.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@fontsource-variable/manrope": "^5.3.0",
    "@fontsource-variable/onest": "^5.3.1",
    "@fontsource-variable/playfair-display": "^5.3.0",
    "@fontsource-variable/unbounded": "^5.3.0",
    "@playwright/test": "^1.63.0",
    "typescript": "6.0.3"
  }
}
